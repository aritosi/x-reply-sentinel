  "structures": [
    {
      "name": "praise_then_restate",
      "re": "^\\s*(great|excellent|love|nice|amazing|interesting)\\b[^.!?]{0,40}[.!?]\\s+(so|this|that|you)\\b",
      "flags": "i",
      "w": 5,
      "f": "template"
    },
    {
      "name": "trailing_generic_question",
      "re": "[.!?]\\s*(what(?:'s| is| are)|how do|any thoughts|thoughts\\??|agree\\??|who else|am i (right|wrong)|your take)\\b[^!?.]{0,60}[?!]?\\s*$",
      "flags": "i",
      "w": 5,
      "f": "template"
    },
    {
      "name": "markdown_bold_bullets",
      "re": "(?:^|\\n)\\s*(?:[-*•]|\\d+[.)])\\s*\\*\\*[^\\n]{2,60}\\*\\*",
      "flags": "",
      "w": 6,
      "f": "formatting"
    },
    {
      "name": "bold_heading_colon",
      "re": "(?:^|\\n)\\s*(?:\\*\\*|#{1,4})\\s*[A-Z][^\\n:]{2,30}[:：]",
      "flags": "",
      "w": 5,
      "f": "formatting"
    },
    {
      "name": "three_bullets",
      "re": "(?:^|\\n)\\s*(?:[-*•]|\\d+[.)])\\s+\\S+(?:[^\\n]*\\n\\s*(?:[-*•]|\\d+[.)])\\s+\\S+){2,}",
      "flags": "",
      "w": 5,
      "f": "formatting"
    },
    {
      "name": "balanced_antithesis",
      "re": "\\b(?:it'?s not|isn'?t (?:just|only|really|merely)|not merely|not just)\\b[^.!?,\\n]{3,60}[,.]\\s*(?:it'?s|that'?s|but|this is)\\s+(?:really |just |only )?(?:about|when|how|a|an|the|more|[A-Za-z])",
      "flags": "i",
      "w": 5,
      "f": "template"
    },
    {
      "name": "decorated_triad",
      "re": "\\b[a-z]+(?:ic|al|ive|ous|ful)\\b,\\s*[a-z]+(?:ic|al|ive|ous|ful)\\b,?\\s*(?:and|or)\\s*[a-z]+(?:ic|al|ive|ous|ful)\\b",
      "flags": "i",
      "w": 4,
      "f": "template"
    },
    {
      "name": "em_dash_pair",
      "re": "[^—\n]{4,}\\s—\\s[^—\n]{4,}\\s—\\s",
      "flags": "",
      "w": 4,
      "f": "formatting"
    },
    {
      "name": "hourglass_close",
      "re": "[.!?]\\s*(?:in summary|bottom line|the takeaway|at the end of the day|ultimately|overall)[,:\\s]",
      "flags": "i",
      "w": 4,
      "f": "template"
    },
    {
      "name": "generic_advice_pair",
